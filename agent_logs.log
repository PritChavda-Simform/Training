me', additional_kwargs={}, response_metadata={}, id='24c67697-cdde-417c-976c-41f9cc3bb70a'), HumanMessage(content='no', additional_kwargs={}, response_metadata={}, id='c3d1e56e-a314-42c3-84f4-eca9a1e09a9c'), HumanMessage(content='classic romances', additional_kwargs={}, response_metadata={}, id='29a7ce9a-bd4b-46fc-b447-9ad7894806c6'), HumanMessage(content='just remember my name', additional_kwargs={}, response_metadata={}, id='4e06f472-9411-44b0-be0b-778670f0d8cc'), HumanMessage(content='no', additional_kwargs={}, response_metadata={}, id='b04dc600-065d-49f1-a53a-85711d30470c'), HumanMessage(content='classic romances', additional_kwargs={}, response_metadata={}, id='aa977882-cc1c-4284-96b7-1fc0f04742fc')]}
