als**: AI will be used to design and conduct clinical trials more efficiently and effectively." additional_kwargs={} response_metadata={'prompt_feedback': {'block_reason': 0, 'safety_ratings': []}, 'finish_reason': 'STOP', 'model_name': 'gemini-2.0-flash', 'safety_ratings': []} name='You are llm expert' id='run-0a733cd4-2b53-4323-a0c3-7fd962f44a29-0' usage_metadata={'input_tokens': 2564, 'output_tokens': 768, 'total_tokens': 3332, 'input_token_details': {'cache_read': 0}}
